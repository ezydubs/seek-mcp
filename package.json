{
  "name": "seek-mcp",
  "version": "0.3.0",
  "description": "MCP server for Seek NZ (nz.seek.com): search jobs, read ads, manage your profile and résumés, and apply — over Seek's own HTTP API, no browser",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seek",
    "jobs",
    "job-search",
    "new-zealand",
    "claude"
  ],
  "author": "ezydubs",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "pdfjs-dist": "^5.6.205",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  },
  "bin": {
    "seek-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezydubs/seek-mcp.git"
  },
  "homepage": "https://github.com/ezydubs/seek-mcp#readme",
  "bugs": {
    "url": "https://github.com/ezydubs/seek-mcp/issues"
  }
}
