{
  "name": "seek-mcp",
  "version": "0.5.0",
  "description": "MCP server for Seek NZ (nz.seek.com): job search, full ads, companies and reviews, career advice and salaries, Career Compass, recruiters, people search, your whole profile, résumés, saved jobs and searches, the home feed and Seek's AI job assessments, notifications and applying — over Seek's own HTTP API, no browser",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check:public": "npm run build && node scripts/check-public.mjs",
    "check:shapes": "npm run build && node scripts/check-shapes.mjs",
    "research:documents": "node scripts/research/gen-documents.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seek",
    "jobs",
    "job-search",
    "new-zealand",
    "claude",
    "company-reviews",
    "salaries",
    "recruiters"
  ],
  "author": "ezydubs",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "pdfjs-dist": "^5.6.205",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "graphql": "^16.9.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "seek-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezydubs/seek-mcp.git"
  },
  "homepage": "https://github.com/ezydubs/seek-mcp#readme",
  "bugs": {
    "url": "https://github.com/ezydubs/seek-mcp/issues"
  }
}
